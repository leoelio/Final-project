    <rgba haze="0.15 0.18 0.22 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.65 0.75" rgb2="0.08 0.1 0.12" width="512" height="3072"/>
    <texture name="table_grid" type="2d" builtin="checker" rgb1="0.42 0.43 0.42" rgb2="0.34 0.35 0.34"
      mark="edge" markrgb="0.75 0.75 0.75" width="256" height="256"/>
    <material name="table_mat" texture="table_grid" texuniform="true" texrepeat="6 4" reflectance="0.15"/>
    <material name="red_mat" rgba="0.9 0.08 0.06 1"/>
    <material name="blue_mat" rgba="0.05 0.22 0.9 1"/>
    <material name="green_mat" rgba="0.05 0.62 0.22 1"/>
