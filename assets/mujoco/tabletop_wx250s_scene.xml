    <geom name="target_blue_pad" type="cylinder" pos="0.50 0.16 0.002" size="0.06 0.002"
      material="blue_mat" contype="0" conaffinity="0"/>
    <geom name="target_bowl" type="cylinder" pos="0.33 0.25 0.006" size="0.07 0.006"
      material="bowl_mat" contype="0" conaffinity="0"/>

    <camera name="top_rgb" pos="0.32 0 1.05" xyaxes="1 0 0 0 1 0" fovy="45"/>
    <camera name="front_rgb" pos="0.78 -0.62 0.46" xyaxes="0.6 0.8 0 -0.35 0.25 0.9" fovy="50"/>

    <body name="red_cube" pos="0.28 -0.12 0.026">
      <freejoint name="red_cube_free"/>
      <geom name="red_cube_geom" type="box" size="0.025 0.025 0.025" material="red_mat" density="450"/>
    </body>
    <body name="blue_cube" pos="0.28 0.00 0.026">
      <freejoint name="blue_cube_free"/>
      <geom name="blue_cube_geom" type="box" size="0.025 0.025 0.025" material="blue_mat" density="450"/>
